# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# NPM_TOKEN is a fine grained npm access token, created at
# https://www.npmjs.com/settings/~/tokens with the "Automation" type and read
# and write permission on the @oqf scope. Automation tokens bypass two factor
# authentication, so `pnpm release` never stops to ask for a one time password.
#
# scripts/publish.sh reads this file, writes the token into a temporary .npmrc
# in the repo root, and deletes that file when it exits. Your global npm config
# is left alone.
NPM_TOKEN=
