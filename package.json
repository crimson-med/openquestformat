{
  "name": "openquestformat",
  "version": "0.1.0",
  "description": "Open Quest Format: an open, engine neutral standard for quests. Spec, canonical model, parsers, validator, runtime, CLI and editor.",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "author": "Mederic Burlet <mederic.burlet@gmail.com>",
  "homepage": "https://github.com/crimson-med/openquestformat#readme",
  "bugs": {
    "url": "https://github.com/crimson-med/openquestformat/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crimson-med/openquestformat.git"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "build": "pnpm -r build",
    "clean": "rm -rf packages/*/dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "format": "biome format --write .",
    "cli": "tsx packages/cli/src/index.ts",
    "editor": "pnpm --filter @oqf/editor dev",
    "release": "bash scripts/publish.sh",
    "release:dry": "bash scripts/publish.sh --dry-run",
    "version:set": "pnpm -r exec npm version --no-git-tag-version --allow-same-version"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@types/node": "^22.10.5",
    "@vitest/coverage-v8": "3.2.6",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@biomejs/biome"
    ]
  }
}
