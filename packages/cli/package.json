{
  "name": "@oqf/cli",
  "version": "0.2.0",
  "description": "The oqf command line for Open Quest Format: validate, convert, import, graph, schema, extract and inject.",
  "keywords": [
    "quest",
    "game",
    "narrative",
    "interactive-fiction",
    "gamedev",
    "oqf",
    "cli",
    "command-line",
    "validator",
    "converter",
    "ink",
    "yarn-spinner"
  ],
  "homepage": "https://github.com/crimson-med/openquestformat/tree/main/packages/cli#readme",
  "bugs": {
    "url": "https://github.com/crimson-med/openquestformat/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crimson-med/openquestformat.git",
    "directory": "packages/cli"
  },
  "license": "Apache-2.0",
  "author": "Mederic Burlet <mederic.burlet@gmail.com>",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "oqf": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "prepack": "tsup"
  },
  "dependencies": {
    "@oqf/core": "workspace:*",
    "@oqf/dialogue": "workspace:*",
    "@oqf/i18n": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.7.3",
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2"
  }
}
