{
  "name": "@oqf/runtime",
  "version": "0.1.0",
  "description": "Open Quest Format runtime: an engine agnostic quest state machine driven by events, for browsers and Node.",
  "keywords": [
    "quest",
    "game",
    "narrative",
    "interactive-fiction",
    "gamedev",
    "oqf",
    "runtime",
    "state-machine",
    "events",
    "quest-system"
  ],
  "homepage": "https://github.com/mburlet/openquestformat/tree/main/packages/runtime#readme",
  "bugs": {
    "url": "https://github.com/mburlet/openquestformat/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mburlet/openquestformat.git",
    "directory": "packages/runtime"
  },
  "license": "Apache-2.0",
  "author": "Mederic Burlet <mederic.burlet@gmail.com>",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "prepack": "tsup"
  },
  "dependencies": {
    "@oqf/core": "workspace:*"
  },
  "devDependencies": {
    "@oqf/dialogue": "workspace:*",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3"
  }
}
