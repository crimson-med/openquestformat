{
  "name": "@oqf/dialogue",
  "version": "0.1.0",
  "description": "Open Quest Format dialogue model, bridge interface, built-in provider, and Ink and Yarn Spinner export and import.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "author": "Mederic Burlet <mederic.burlet@gmail.com>",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "prepack": "tsup"
  },
  "dependencies": {
    "@oqf/core": "workspace:*"
  },
  "devDependencies": {
    "inkjs": "^2.4.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3"
  },
  "peerDependencies": {
    "inkjs": "^2.4.0"
  },
  "peerDependenciesMeta": {
    "inkjs": {
      "optional": true
    }
  }
}
