    "inkjs": "^2.4.0"
  },
  "peerDependenciesMeta": {
    "inkjs": {
      "optional": true
    }
  },
  "devDependencies": {
    "inkjs": "^2.4.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3"
