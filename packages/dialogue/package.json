{
  "name": "@oqf/dialogue",
  "version": "0.1.0",
  "description": "Open Quest Format dialogue model, bridge interface, built-in provider, and Ink and Yarn Spinner export and import.",
  "keywords": [
    "quest",
    "game",
    "narrative",
    "interactive-fiction",
    "gamedev",
    "oqf",
    "dialogue",
    "ink",
    "yarn-spinner",
    "branching-dialogue",
    "conversation"
  ],
  "homepage": "https://github.com/mburlet/openquestformat/tree/main/packages/dialogue#readme",
  "bugs": {
    "url": "https://github.com/mburlet/openquestformat/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mburlet/openquestformat.git",
    "directory": "packages/dialogue"
  },
  "license": "Apache-2.0",
  "author": "Mederic Burlet <mederic.burlet@gmail.com>",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
