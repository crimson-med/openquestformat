{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "paths": {},
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "declarationMap": false,
    "sourceMap": false,
    "rootDir": "src",
    "outDir": "dist/lib",
    "declarationDir": "dist/lib"
  },
  "include": ["src"],
  "exclude": ["src/main.tsx", "src/**/*.test.ts", "src/**/*.test.tsx"]
}
