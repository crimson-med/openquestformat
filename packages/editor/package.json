{
  "name": "@oqf/editor",
  "version": "0.2.0",
  "description": "Open Quest Format web editor: step graph, inspector, live validation, dialogue editor, import and export in every format.",
  "keywords": [
    "quest",
    "game",
    "narrative",
    "interactive-fiction",
    "gamedev",
    "oqf",
    "editor",
    "react",
    "vite",
    "graph-editor"
  ],
  "homepage": "https://github.com/crimson-med/openquestformat/tree/main/packages/editor#readme",
  "bugs": {
    "url": "https://github.com/crimson-med/openquestformat/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crimson-med/openquestformat.git",
    "directory": "packages/editor"
  },
  "license": "Apache-2.0",
  "author": "Mederic Burlet <mederic.burlet@gmail.com>",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/lib/index.js",
  "module": "./dist/lib/index.js",
  "types": "./dist/lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib/index.d.ts",
      "import": "./dist/lib/index.js"
    },
    "./styles.css": "./dist/lib/styles.css",
    "./package.json": "./package.json"
  },
  "bin": {
    "oqf-editor": "./bin/oqf-editor.js"
  },
  "files": [
    "dist",
    "bin"
  ],
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm run build:lib && pnpm run build:app",
    "build:lib": "vite build --config vite.lib.config.ts && tsc -p tsconfig.lib.json && node scripts/strip-css-imports.mjs",
    "build:app": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@oqf/core": "workspace:*",
    "@oqf/dialogue": "workspace:*",
    "@oqf/i18n": "workspace:*",
    "@oqf/runtime": "workspace:*",
    "@xyflow/react": "^12.11.6"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.7.3",
    "vite": "^6.4.3"
  }
}
