{
  "name": "@oqf/i18n",
  "version": "0.1.0",
  "description": "Open Quest Format string extraction and injection for localization, with JSON, CSV, PO and XLIFF tables.",
  "keywords": [
    "quest",
    "game",
    "narrative",
    "interactive-fiction",
    "gamedev",
    "oqf",
    "i18n",
    "l10n",
    "localization",
    "translation",
    "xliff",
    "gettext"
  ],
  "homepage": "https://github.com/mburlet/openquestformat/tree/main/packages/i18n#readme",
  "bugs": {
    "url": "https://github.com/mburlet/openquestformat/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mburlet/openquestformat.git",
    "directory": "packages/i18n"
  },
  "license": "Apache-2.0",
  "author": "Mederic Burlet <mederic.burlet@gmail.com>",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "prepack": "tsup"
  },
  "dependencies": {
    "@oqf/core": "workspace:*",
    "@oqf/dialogue": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.7.3"
  }
}
