{
  "name": "@oqf/core",
  "version": "0.1.0",
  "description": "Open Quest Format canonical model, compact and JSON parsers and serializers, condition language, Markdown export, JSON Schema and validator.",
  "keywords": [
    "quest",
    "game",
    "narrative",
    "interactive-fiction",
    "gamedev",
    "oqf",
    "quest-system",
    "parser",
    "serializer",
    "validator",
    "json-schema"
  ],
  "homepage": "https://github.com/crimson-med/openquestformat/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/crimson-med/openquestformat/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crimson-med/openquestformat.git",
    "directory": "packages/core"
  },
  "license": "Apache-2.0",
  "author": "Mederic Burlet <mederic.burlet@gmail.com>",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "prepack": "tsup"
  },
  "dependencies": {},
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.7.3"
  }
}
