{
  "name": "@oqf/examples",
  "version": "0.1.0",
  "description": "Reference quests, dialogue and templates for Open Quest Format, used as fixtures by every package.",
  "keywords": [
    "quest",
    "game",
    "narrative",
    "interactive-fiction",
    "gamedev",
    "oqf",
    "examples",
    "fixtures",
    "templates",
    "reference"
  ],
  "homepage": "https://github.com/crimson-med/openquestformat/tree/main/packages/examples#readme",
  "bugs": {
    "url": "https://github.com/crimson-med/openquestformat/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crimson-med/openquestformat.git",
    "directory": "packages/examples"
  },
  "license": "Apache-2.0",
  "author": "Mederic Burlet <mederic.burlet@gmail.com>",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "quests"
  ],
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "prepack": "tsup"
  },
  "dependencies": {},
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.7.3",
    "@types/node": "^22.10.5"
  }
}
