{
  "oqd": 1,
  "speakers": [
    {
      "id": "harbormaster",
      "name": "Harbormaster Ines"
    },
    {
      "id": "gull_feeder",
      "name": "The Gull Feeder"
    },
    {
      "id": "otter",
      "name": "Old Salt Otter"
    },
    {
      "id": "smuggler",
      "name": "Cove Smuggler"
    }
  ],
  "conversations": [
    {
      "id": "ines_intro",
      "actor": "harbormaster",
      "title": "Ines asks for help",
      "start": "greet",
      "nodes": [
        {
          "id": "greet",
          "text": "The ledger is gone. Sixty years of catches, and it walks off the pier in a single night. Will you help me find it?",
          "choices": [
            {
              "text": "Tell me about the old lighthouse.",
              "next": "lighthouse"
            },
            {
              "text": "How old is this pier?",
              "next": "pier_history"
            },
            {
              "text": "Why does one book matter so much?",
              "next": "why_ledger"
            },
            {
              "text": "I will find it.",
              "next": "promise"
            }
          ]
        },
        {
          "id": "lighthouse",
          "text": "Dark since the storm of the ninth. The lamp is still up there, waiting for someone stubborn enough to climb.",
          "next": "greet",
          "lore": true
        },
        {
          "id": "pier_history",
          "text": "Older than the town. The first planks went down when my grandmother was a girl, and half of them are still under your boots.",
          "next": "greet",
          "lore": true
        },
        {
          "id": "why_ledger",
          "text": "Every catch, every debt, every share of every boat. Without it the whole season is a rumor.",
          "next": "greet",
          "lore": true
        },
        {
          "id": "promise",
          "text": "Thank you. Ask around the pier first, someone always sees more than they let on."
        }
      ],
      "ext": {
        "x-editor.pos": {
          "x": 40,
          "y": 40
        }
      }
    },
    {
      "id": "gulls_hint",
      "actor": "gull_feeder",
      "title": "The Gull Feeder points the way",
      "start": "ask",
      "nodes": [
        {
          "id": "ask",
          "text": "Careful where you step. They remember faces, these birds.",
          "choices": [
            {
              "text": "Has anyone come past with a big leather book?",
              "next": "tell"
            },
            {
              "text": "You feed them every morning?",
              "next": "gulls"
            },
            {
              "text": "Never mind."
            }
          ]
        },
        {
          "id": "tell",
          "text": "Old Salt Otter took it, down in the den under the boardwalk. He reads it like a bedtime story.",
          "set": [
            {
              "flag": "knows_otter"
            }
          ]
        },
        {
          "id": "gulls",
          "text": "Every morning since the lighthouse went dark. Better company than most of this pier, and they never ask for change.",
          "lore": true
        }
      ]
    },
    {
      "id": "otter_trade",
      "actor": "otter",
      "title": "The otter names his price",
      "start": "offer",
      "nodes": [
        {
          "id": "offer",
          "text": "The ledger? Fine reading. Five silver koi and it is yours, and no haggling.",
          "choices": [
            {
              "text": "Here. Five silver koi, fresh off the line.",
              "next": "handover",
              "condition": {
                ">=": [
                  {
                    "var": "count.trade"
                  },
                  5
                ]
              },
              "show": "disabled",
              "set": [
                {
                  "flag": "otter_agreed"
                },
                {
                  "flag": "otter_traded"
                }
              ],
              "once": true,
              "ext": {
                "x-cozycoast.sfx": "coins"
              }
            },
            {
              "text": "What does an otter want with a harbor ledger?",
              "next": "curiosity"
            },
            {
              "text": "I do not have the fish yet.",
              "next": "come_back"
            }
          ]
        },
        {
          "id": "handover",
          "text": "A deal is a deal. Mind the salt stains, those are mine.",
          "emit": [
            {
              "event": "cozycoast.ledger.handed",
              "payload": {
                "from": "otter"
              }
            }
          ]
        },
        {
          "id": "curiosity",
          "text": "Names of every boat that ever stiffed me, in one tidy column. I call that a library.",
          "next": "offer"
        },
        {
          "id": "come_back",
          "text": "Then go fish. The tide is patient and so am I."
        }
      ]
    },
    {
      "id": "ines_return",
      "actor": "harbormaster",
      "title": "Ines takes the ledger back",
      "start": "thanks",
      "nodes": [
        {
          "id": "thanks",
          "text": "You found it. Salt stained, dog eared, and every page still here.",
          "next": "farewell"
        },
        {
          "id": "farewell",
          "text": "The season is safe. Go on, the pier owes you a quiet evening."
        }
      ]
    },
    {
      "id": "smuggler_deal",
      "actor": "smuggler",
      "title": "The smuggler makes an offer",
      "start": "offer",
      "nodes": [
        {
          "id": "offer",
          "text": "Two hundred coins, and the harbor never hears your name from me. Well?",
          "choices": [
            {
              "text": "What do you want with it?",
              "next": "curiosity"
            },
            {
              "text": "Deal.",
              "next": "accept",
              "emit": [
                {
                  "event": "cozycoast.smuggler.deal",
                  "payload": {
                    "price": 200
                  }
                }
              ]
            },
            {
              "text": "Not today.",
              "next": "walk_away"
            }
          ],
          "ext": {
            "x-cozycoast.camera": "cove_wide"
          }
        },
        {
          "id": "curiosity",
          "text": "Every debt on this coast, written down and signed. A book like that pays for itself twice.",
          "next": "offer"
        },
        {
          "id": "accept",
          "text": "Pleasure. Come back when you have something else nobody should be missing."
        },
        {
          "id": "walk_away",
          "text": "Suit yourself. The offer keeps, and so do I."
        }
      ]
    }
  ]
}
